{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.0",
  "identifier": "dev.pulsebar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Pulse",
        "width": 372,
        "height": 480,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["popover"],
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "createUpdaterArtifacts": false,
    "publisher": "Pulse",
    "homepage": "https://github.com/praveensankar969/pulse",
    "shortDescription": "Pulse — Service Monitor",
    "longDescription": "Local menu-bar health monitor for HTTP endpoints you own.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowPosition": { "x": 240, "y": 140 },
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 168, "y": 188 },
        "applicationFolderPosition": { "x": 492, "y": 188 }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "windows/nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNkQyN0JBNjNENDdBRTcKUldUbmV0Ump1aWR0WGdoQ2xlK2NnNFp6UjhYc2tHNnc5THg5NWdYT0VTTml2MUlhTURnQkp6dnQK",
      "endpoints": [
        "https://github.com/praveensankar969/pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
