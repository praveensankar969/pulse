{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Glance list. No secret-reveal commands.",
  "windows": [
    "popover"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "allow-scheduler",
    "allow-should-suppress-blur",
    "allow-open-detail",
    "allow-get-settings",
    "allow-open-settings",
    "allow-open-editor"
  ]
}
